# Merge these additions into your existing .env; do not replace existing secrets.
# Keep JWT_SECRET_KEY, JWT_ISSUER, JWT_AUDIENCE and MongoDB/model configuration.
REDIS_URL=redis://localhost:6379/0

# Secure by default. Set false explicitly ONLY for local development over HTTP.
REFRESH_COOKIE_SECURE=true

# Phase 3.6 document uploads: relative UPLOAD_DIR resolves under the project root.
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# Long-conversation summarization: summarize once completed messages exceed
# SUMMARY_THRESHOLD; re-summarize after SUMMARY_MAX_AGE new messages.
SUMMARY_THRESHOLD=20
SUMMARY_MAX_AGE=10

# Phase 2 hybrid BM25 + vector retrieval (flag-gated, default off).
# Over-fetch max(2*k, HYBRID_OVERFETCH_MIN) per leg, clamped to 10
# (Chroma single-query limit), fused with RRF HYBRID_RRF_K=60.
HYBRID_ENABLED=false
HYBRID_RRF_K=60
HYBRID_OVERFETCH_MIN=20

# Phase 3a cross-encoder reranking (flag-gated, default off).
# Rescores the over-fetched candidate window (up to 10 chunks) and keeps
# min(k, RERANKER_TOP_K). Model loads lazily on first reranked query.
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_TOP_K=5
# Phase 4 JWT blacklisting needs no env: revoked access JTIs live in
# Redis as auth:blacklist:<jti> with EXAT = token expiry (auto-expire).

# Phase 5 response caching (flag-gated, default off). Identical queries
# against unchanged documents reuse the stored answer instead of a fresh
# Gemini call. Any upload/delete for a user orphans their entries (they
# expire on their own after CACHE_TTL_SECONDS).
CACHE_ENABLED=false
CACHE_TTL_SECONDS=3600

# Phase 6 production retries: transient failures (timeout, connection
# errors, 429/5xx) retry with exponential backoff + jitter; other 4xx,
# auth/duplicate-key errors, and bugs never retry. After
# CIRCUIT_BREAKER_THRESHOLD consecutive transient failures the circuit
# opens and calls fail fast for CIRCUIT_BREAKER_COOLDOWN_SECONDS.
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=0.5
RETRY_MAX_DELAY=8.0
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=30

# Phase 7 degraded LLM responses (flag-gated, default off). After retries
# are exhausted, an unavailable LLM serves the top retrieved chunks as
# plain-text excerpts instead of an error. Served fallbacks are counted
# in Redis (llm:degraded:responses) for monitoring.
DEGRADED_MODE_ENABLED=false
DEGRADED_MAX_CHUNKS=3

# Phase 8 token/cost monitoring (always on): per-request Gemini token
# counts are logged to MongoDB usage_logs with a USD estimate at these
# per-1K-token rates. Served from GET /api/v1/usage (daily/weekly).
COST_PER_1K_INPUT=0.0001
COST_PER_1K_OUTPUT=0.0004

# Phase 11 agent loop (flag-gated, default off). When enabled, chat
# requests route through retrieve → rerank → generate →
# check_confidence → respond_or_retry, reusing the hybrid retriever and
# cross-encoder reranker. Weak answers retry with a wider k window up
# to AGENT_MAX_ITERATIONS loops; below AGENT_CONFIDENCE_THRESHOLD the
# best-effort answer (or refusal) is returned. Any agent failure falls
# back to the legacy pipeline. Streams keep the legacy path.
AGENT_ENABLED=false
AGENT_MAX_ITERATIONS=3
AGENT_CONFIDENCE_THRESHOLD=0.5

# Phase 12 agent tools (no new dependencies; stdlib only). Calculator
# answers math directly with safe AST evaluation (never eval). Web
# search grounds current-events queries via SEARCH_BACKEND=tavily
# (TAVILY_API_KEY) or serpapi (SERPAPI_API_KEY); unset/misconfigured
# backends fall back to local retrieval instead of failing the turn.
SEARCH_BACKEND=none
# TAVILY_API_KEY=
# SERPAPI_API_KEY=
SEARCH_MAX_RESULTS=5
SEARCH_TIMEOUT_SECONDS=10
CALCULATOR_MAX_EXPR_LEN=200
